# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Runtime connection: POOLED host (-pooler), role lms_app (cannot bypass RLS, no DDL)
DATABASE_URL=postgresql://lms_app:PASSWORD@ep-XXXX-pooler.c-2.eu-west-2.aws.neon.tech/lms?sslmode=require

# Migrations connection: DIRECT host (no -pooler), role lms_owner
DATABASE_URL_OWNER=postgresql://lms_owner:PASSWORD@ep-XXXX.c-2.eu-west-2.aws.neon.tech/lms?sslmode=require

# Optional: Neon read replica (pooled host). Empty = reads stay on DATABASE_URL.
DATABASE_URL_REPLICA=

# Redis: cache, sessions, rate limits, Celery. Local: `docker compose up -d redis`
# then REDIS_URL=redis://localhost:6379/0. Empty = in-memory fallback (single process only).
REDIS_URL=

# Production only
DJANGO_ADMIN_URL=admin/
NINJA_NUM_PROXIES=0
LOG_LEVEL=INFO

FRONTEND_URL=http://localhost:5173

# Sign in with Google / Microsoft (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft sign-in: its own app registration (delegated, redirect URI), not the mail one
MICROSOFT_LOGIN_CLIENT_ID=
MICROSOFT_LOGIN_CLIENT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Bunny Stream (standard library for this environment)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOST=
BUNNY_STREAM_READONLY_KEY=

# Stripe (test mode keys: sk_test_..., whsec_...). Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: console (default, nothing is sent) or graph (Microsoft Graph, app permission Mail.Send)
MAIL_MODE=console
# Same names and values as Communication Centre
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_GRAPH_SCOPE=https://graph.microsoft.com/.default
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# The no-reply mailbox the app sends as (must exist in the tenant)
MICROSOFT_GRAPH_SENDER=no-reply@kentbusinesscollege.com
# Teams: the Microsoft 365 user that owns sessions created by LearnHub. The app also
# needs Graph application permission OnlineMeetings.ReadWrite.All plus an application
# access policy that includes this user.
TEAMS_MEETING_ORGANIZER=training@kentbusinesscollege.com
# Safety switch: only these recipient domains get mail (empty = everyone). Keep it set for demos.
MAIL_ALLOWED_DOMAINS=kentbusinesscollege.com

# File storage: Azure Blob (private container; the app signs short-lived links)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=lms-resources
AZURE_STORAGE_TENANT_ID=
AZURE_STORAGE_CLIENT_ID=
AZURE_STORAGE_CLIENT_SECRET=

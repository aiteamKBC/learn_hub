{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
  "allow": [
    "Bash(python:*)", "Bash(py:*)", "Bash(node:*)", "Bash(npm run:*)", "Bash(npx tsc:*)", "Bash(npx vite:*)",
    "Bash(npx playwright:*)", "Bash(npx --yes -p openapi-typescript:*)",
    "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git add:*)",
    "Bash(git commit:*)", "Bash(git switch:*)", "Bash(git checkout:*)", "Bash(git branch:*)",
    "Bash(git push origin frontend-m3-m6:*)", "Bash(git push -u origin frontend-m3-m6:*)",
    "Bash(ls:*)", "Bash(dir:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(grep:*)", "Bash(find:*)",
    "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(echo:*)", "Bash(curl -s http://localhost:*)"
  ],
  "ask": [
    "Bash(python manage.py migrate:*)", "Bash(npm install:*)", "Bash(pip install:*)",
    "Bash(git merge:*)", "Bash(git reset:*)", "Bash(git rebase:*)"
  ],
  "deny": [
    "Read(./backend/.env)", "Read(./backend/.env.*)", "Read(./frontend/.env)", "Read(./frontend/.env.*)",
    "Edit(./backend/.env)", "Edit(./frontend/.env)",
    "Bash(git push origin main:*)", "Bash(git push -f:*)", "Bash(git push --force:*)"
  ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_python.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/goal_gate.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/context.py\""
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  }
}
